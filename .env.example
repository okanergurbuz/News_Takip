# Discord Incoming Webhook adresi (zorunlu)
DISCORD_WEBHOOK_URL=

# Google Gemini API anahtarı (config.yaml'da provider: "gemini" iken kullanılır;
# https://aistudio.google.com adresinden ücretsiz alınır)
GEMINI_API_KEY=

# Anthropic API anahtarı (config.yaml'da provider: "anthropic" iken kullanılır)
ANTHROPIC_API_KEY=

# Not: Seçili sağlayıcının anahtarı boşsa LLM özeti atlanır, bülten
# feed'lerin kendi (İngilizce) özetleriyle gönderilir.
